#!/usr/bin/env bash
# Run the bridge as a two-way relay between a Talon party line and
# something this machine can only reach through an app — an X Space
# being the case it was written for.
#
# You join the Space in your own client as a speaker. This makes the
# bridge that client's microphone and speaker, so the party line
# arrives at X as mic input and the Space comes back out. You speak
# and listen in Talon; X never touches your real mic or speakers.
#
# Two null sinks, because both ends must be dedicated devices. Talon
# is very likely running on this same machine, and capturing the
# system monitor instead would push the party line's own playback
# straight back into the Space.
#
#     party line -> bridge -> TalonBridgeMic  -(monitor)-> X mic
#     Space -> X out -> TalonBridgeSpace -(monitor)-> bridge -> party line
#
# Linux/PipeWire/PulseAudio only. macOS and Windows have no way to
# create a virtual device without installing a driver (BlackHole,
# VB-Cable); point AUDIO_IN/AUDIO_OUT at those instead and skip this.

set -euo pipefail

command -v pactl >/dev/null || {
	echo "talon-bridge: pactl not found — this script is for PipeWire/PulseAudio" >&2
	exit 1
}

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
bridge="${TALON_BRIDGE_BIN:-$here/../build/install/talon-bridge/bin/talon-bridge}"
[ -x "$bridge" ] || {
	echo "talon-bridge: no binary at $bridge — run ./gradlew :bridge:installDist" >&2
	exit 1
}

mic_mod=""
space_mod=""
cleanup() {
	# Unload in reverse, and never fail the exit path over it.
	[ -n "$space_mod" ] && pactl unload-module "$space_mod" 2>/dev/null || true
	[ -n "$mic_mod" ] && pactl unload-module "$mic_mod" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

# Descriptions carry no spaces on purpose: pactl's own property
# parser splits on them and the load fails outright, whatever the
# shell quoting. Verified against escaped and inner-quoted forms —
# both are rejected. So these strings are exactly what X will show.
mic_mod=$(pactl load-module module-null-sink \
	sink_name=TalonBridgeMic \
	sink_properties=device.description=TalonBridgeMic \
	rate=48000 channels=1)
space_mod=$(pactl load-module module-null-sink \
	sink_name=TalonBridgeSpace \
	sink_properties=device.description=TalonBridgeSpace \
	rate=48000 channels=1)

cat <<'EOF'

Devices are up. In your X client, set:

  Microphone  ->  Monitor of TalonBridgeMic
  Output      ->  TalonBridgeSpace

The browser sets output per tab (right-click the tab, or the OS
volume mixer). The native app follows the system default, so use a
browser unless you want everything routed here.

Then join the Space as a speaker. Ctrl-C removes both devices.

EOF

# PULSE_SINK steers playback, PULSE_SOURCE steers capture; both are
# honoured for a Java stream through the ALSA default device, which
# is the only thing javax.sound can see on Linux.
export PULSE_SINK=TalonBridgeMic
export PULSE_SOURCE=TalonBridgeSpace.monitor
export TALON_BRIDGE_AUDIO_IN="${TALON_BRIDGE_AUDIO_IN:-default}"
export TALON_BRIDGE_AUDIO_OUT="${TALON_BRIDGE_AUDIO_OUT:-default}"

# Deliberately not exec: exec replaces this shell, so the EXIT trap
# never runs and both null sinks outlive the bridge. Run it as a
# child instead and let the trap tear them down.
#
# The signal is forwarded rather than assumed. A terminal Ctrl-C
# reaches the whole foreground process group, so the bridge gets it
# either way — but a supervisor signalling this script's pid alone
# does not, and bash defers a trap until the foreground child exits.
# Measured: without this, a lone SIGTERM leaves both the child and
# both null sinks running forever.
"$bridge" "$@" &
child=$!
trap 'kill -TERM "$child" 2>/dev/null || true' INT TERM
wait "$child" || true
