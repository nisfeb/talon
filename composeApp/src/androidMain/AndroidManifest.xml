<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 11+ package visibility: without this, queryIntentActivities
         for the urb:// scheme is filtered to empty even when Lattice is
         installed, so AndroidUrbLinkLauncher would always report
         NotInstalled.
         -
         The <package> entry is the load-bearing one — it makes Lattice
         visible to PackageManager unconditionally, sidestepping
         intent-filter matching nuance across OEM ROMs (we had reports
         of users with Lattice installed still seeing the install prompt
         while stock-Android testers didn't reproduce). The <intent>
         entry stays as forward-compat for any third-party urb:// handler;
         it mirrors the categories Lattice's filter actually declares
         (DEFAULT + BROWSABLE) so the visibility match is exact. -->
    <queries>
        <package android:name="io.nisfeb.lattice" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="urb" />
        </intent>
    </queries>

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Incoming calls take over a locked screen. Auto-granted for
         apps that post CATEGORY_CALL notifications; without it the
         ring degrades to a heads-up banner. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Android 14+ feeds silence to the mic once the app is not
         visible unless a microphone-typed FGS is running. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Video calls. Optional hardware: a device without a camera can
         still take audio calls, and the store listing should not
         exclude it. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!--
      Sideload distribution only — required by UpdateInstaller to
      hand a downloaded APK to PackageInstaller. Google Play's
      Device and Network Abuse policy + the restricted-permissions
      review process effectively disqualify Talon from Play with
      this permission declared. Any Play Store flavor must strip
      this line, the FileProvider below, and the io.nisfeb.talon.update
      package. See docs/release-channels.md for the flavor split plan.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      Image-download support on pre-Q devices: writing to public
      Pictures/Talon/ uses the legacy storage path on API 26-28,
      which still requires this permission. API 29+ uses MediaStore
      with RELATIVE_PATH and doesn't need it — maxSdkVersion="28"
      keeps newer devices clean.
    -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:name="io.nisfeb.talon.TalonApplication"
        android:label="Talon"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:allowBackup="false"
        android:theme="@style/Theme.Talon"
        android:usesCleartextTraffic="true">

        <!-- configChanges: CallController / PartyLine live in this
             activity's composition, so recreating the activity on a
             rotation, split-screen resize, dark-mode flip, or density
             change hangs up a live call. Handle them in-process —
             Compose relayouts on its own; nothing here needs the
             recreate. -->
        <activity
            android:name="io.nisfeb.talon.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Talon">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/*" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <service
            android:name="io.nisfeb.talon.TalonSyncService"
            android:exported="false"
            android:foregroundServiceType="specialUse|dataSync">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Maintains a persistent SSE channel to the user's self-hosted Urbit ship so chat and DM events arrive in real time. Urbit ships do not push to FCM or any other cloud relay, so a long-lived foreground connection is the only delivery mechanism. dataSync's 6-hour daily cap (Android 15+) terminates the sync mid-day for active users." />
        </service>

        <service
            android:name="io.nisfeb.talon.CallForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone|camera" />

        <receiver
            android:name="io.nisfeb.talon.DigestAlarmReceiver"
            android:exported="false" />

        <receiver
            android:name="io.nisfeb.talon.LoopAlarmReceiver"
            android:exported="false" />

        <receiver
            android:name="io.nisfeb.talon.CallActionReceiver"
            android:exported="false" />

        <receiver
            android:name="io.nisfeb.talon.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!--
          UnifiedPush dispatch receiver. The user's chosen
          distributor (ntfy / NextPush / Conversations / …) sends
          these intents when (a) the relay POSTs a notification to
          our endpoint URL, or (b) the distributor mints / revokes
          the endpoint itself. Connector library handles the
          transport details; we just override the four lifecycle
          callbacks. See notify/TalonMessagingReceiver.kt.
        -->
        <receiver
            android:name="io.nisfeb.talon.notify.TalonMessagingReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.MESSAGE" />
                <action android:name="org.unifiedpush.android.connector.UNREGISTERED" />
                <action android:name="org.unifiedpush.android.connector.NEW_ENDPOINT" />
                <action android:name="org.unifiedpush.android.connector.REGISTRATION_FAILED" />
            </intent-filter>
        </receiver>

        <!--
          Sideload distribution only — pairs with the
          REQUEST_INSTALL_PACKAGES permission above. UpdateInstaller
          uses this provider to mint a content:// URI for the
          downloaded APK before handing it to PackageInstaller. Any
          Play Store flavor must strip this provider along with the
          permission. See docs/release-channels.md.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
